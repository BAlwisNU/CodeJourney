# Copy to deploy/.env on the server and fill in. deploy/.env is gitignored --
# it holds the database password and the signing secret, and neither belongs in
# a public repository.

# openssl rand -hex 32
POSTGRES_PASSWORD=
SECRET_KEY=

# The domain pointing at this server. Needed for TLS: Let's Encrypt will not
# issue a certificate for a bare IP address.
API_DOMAIN=api.example.com
API_BASE_URL=https://api.example.com

# Your Vercel site. Becomes the one allowed CORS origin, and where OAuth
# sign-ins are handed back to.
WEB_APP_URL=https://code-journey-six.vercel.app

# Optional: without it the tutor and welcome chat degrade to a friendly note.
ANTHROPIC_API_KEY=

# Optional: the code someone types to create a TEACHER account, which can see
# its students' progress and read their journals. Unset means teacher signup is
# not offered at all and the endpoint refuses -- never half-open. Pick something
# unguessable and give it only to staff:
#     openssl rand -hex 8
TEACHER_SIGNUP_CODE=
